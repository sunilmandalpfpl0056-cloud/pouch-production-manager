<!doctype html>
<html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#14532d"><link rel="manifest" href="./manifest.webmanifest"><title>Pouch Production Manager</title>
<style>
:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#17221b;background:#f3f6f4}*{box-sizing:border-box}body{margin:0}header{background:#14532d;color:white;padding:18px 16px}header h1{font-size:22px;margin:0 0 4px}header p{margin:0;opacity:.85;font-size:13px}.wrap{max-width:980px;margin:auto;padding:14px}.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-bottom:14px}.stat,.panel{background:white;border:1px solid #dce5de;border-radius:13px;padding:13px}.stat small{display:block;color:#64736a}.stat strong{font-size:21px}.panel{margin-bottom:14px}.panel h2{font-size:18px;margin:0 0 12px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}label{font-size:13px;color:#425248;display:block}input,select,textarea{width:100%;margin-top:5px;border:1px solid #cbd5ce;border-radius:9px;padding:11px;font:inherit;background:#fff;min-width:0}textarea{min-height:70px}.full{grid-column:1/-1}.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}button{border:0;border-radius:9px;padding:11px 14px;font:600 14px system-ui;background:#166534;color:white}button.secondary{background:#e5eee7;color:#17472a}button.danger{background:#b42318}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:13px;white-space:nowrap}th,td{padding:9px;border-bottom:1px solid #e4eae5;text-align:left}th{background:#f3f7f4}.actions button{padding:6px 9px;margin-right:4px}.muted{color:#64736a;font-size:12px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.filters input,.filters select{width:auto;flex:1;min-width:130px}@media(min-width:700px){.stats{grid-template-columns:repeat(4,1fr)}.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style></head><body><header><h1>📦 Pouch Production Manager</h1><p>Daily production • Input / Output Material • Reports</p></header><main class="wrap"><section class="stats"><div class="stat"><small>Total Production (PCS)</small><strong id="sActual">0</strong></div><div class="stat"><small>Total Target (PCS)</small><strong id="sTarget">0</strong></div><div class="stat"><small>Input Material (KG)</small><strong id="sInput">0</strong></div><div class="stat"><small>Output Material (KG)</small><strong id="sOutput">0</strong></div></section>
<section class="panel"><h2 id="formTitle">➕ Add Production Entry</h2><form id="entry"><input type="hidden" id="editId"><div class="grid">
<label>Date<input id="date" type="date" required></label><label>Shift<select id="shift"><option>Day</option><option>Night</option><option>A</option><option>B</option><option>C</option></select></label>
<label>Machine No.<input id="machine" placeholder="Machine number"></label><label>Operator<input id="operator" placeholder="Operator name"></label>
<label>Pouch Height (mm)<input id="height" type="number" step="any"></label><label>Pouch Width (mm)<input id="width" type="number" step="any"></label>
<label>Pouch Type<input id="type" placeholder="Doypack / Center seal"></label><label>Input Material (KG)<input id="inputMaterial" type="number" min="0" step="any" value="0"></label>
<label>Output Material (KG)<input id="outputMaterial" type="number" min="0" step="any" value="0"></label><label>Target (PCS)<input id="target" type="number" min="0" step="1" value="0"></label>
<label>Actual Production (PCS)<input id="actual" type="number" min="0" step="1" value="0"></label><label>Rejection (PCS)<input id="rejection" type="number" min="0" step="1" value="0"></label>
<label>Machine Stop (Minutes)<input id="stopMinutes" type="number" min="0" step="any" value="0"></label><label>Stop Reason<input id="stopReason" placeholder="Reason"></label><label class="full">Remarks<textarea id="remarks" placeholder="Additional details"></textarea></label>
</div><div class="btns"><button type="submit" id="saveBtn">Save Production</button><button type="button" class="secondary" id="resetBtn">Clear Form</button></div></form></section>
<section class="panel"><h2>📋 Production Records</h2><div class="filters"><input id="search" placeholder="Search machine / operator / pouch"><input id="from" type="date" aria-label="From date"><input id="to" type="date" aria-label="To date"><select id="filterShift"><option value="">All shifts</option><option>Day</option><option>Night</option><option>A</option><option>B</option><option>C</option></select></div><div class="btns" style="margin:0 0 10px"><button type="button" class="secondary" id="csvBtn">Export CSV</button><button type="button" class="secondary" id="printBtn">Print</button></div><div class="tablewrap"><table><thead><tr><th>Date</th><th>Shift</th><th>Machine</th><th>Operator</th><th>Pouch</th><th>Input KG</th><th>Output KG</th><th>Target</th><th>Actual</th><th>Reject</th><th>Stop Min</th><th>Actions</th></tr></thead><tbody id="rows"><tr><td colspan="12" class="muted">No production records yet.</td></tr></tbody></table></div><p class="muted">Records are saved on this device/browser. Export CSV regularly as backup.</p></section></main>
<script>
const $=id=>document.getElementById(id), KEY='pouchProductionRecordsV2';let records=[];try{records=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){records=[]}const fields=['date','shift','machine','operator','height','width','type','inputMaterial','outputMaterial','target','actual','rejection','stopMinutes','stopReason','remarks'];$('date').value=new Date().toISOString().slice(0,10);
function save(){localStorage.setItem(KEY,JSON.stringify(records));render()}
function val(id){return $(id).value.trim()}
function reset(){ $('entry').reset();$('editId').value='';$('date').value=new Date().toISOString().slice(0,10);$('formTitle').textContent='➕ Add Production Entry';$('saveBtn').textContent='Save Production'}
$('entry').addEventListener('submit',e=>{e.preventDefault();let item={id:$('editId').value||String(Date.now())};fields.forEach(k=>item[k]=val(k));['height','width','inputMaterial','outputMaterial','target','actual','rejection','stopMinutes'].forEach(k=>item[k]=Number(item[k]||0));let i=records.findIndex(x=>x.id===item.id);if(i>=0)records[i]=item;else records.unshift(item);save();reset()});$('resetBtn').onclick=reset;
function edit(id){let r=records.find(x=>x.id===id);if(!r)return;fields.forEach(k=>$(k).value=r[k]??'');$('editId').value=id;$('formTitle').textContent='✏️ Edit Production Entry';$('saveBtn').textContent='Update Production';window.scrollTo({top:0,behavior:'smooth'})}
function del(id){if(confirm('Delete this production record?')){records=records.filter(x=>x.id!==id);save()}}
function filtered(){let q=val('search').toLowerCase(),f=val('from'),t=val('to'),s=val('filterShift');return records.filter(r=>(!q||[r.machine,r.operator,r.type,r.stopReason].join(' ').toLowerCase().includes(q))&&(!f||r.date>=f)&&(!t||r.date<=t)&&(!s||r.shift===s))}
function render(){let sum=k=>records.reduce((a,r)=>a+Number(r[k]||0),0);$('sActual').textContent=sum('actual').toLocaleString('en-IN');$('sTarget').textContent=sum('target').toLocaleString('en-IN');$('sInput').textContent=sum('inputMaterial').toFixed(2);$('sOutput').textContent=sum('outputMaterial').toFixed(2);let list=filtered();$('rows').innerHTML=list.length?list.map(r=>`<tr><td>${esc(r.date)}</td><td>${esc(r.shift)}</td><td>${esc(r.machine)}</td><td>${esc(r.operator)}</td><td>${esc(r.type)}</td><td>${Number(r.inputMaterial||0).toFixed(2)}</td><td>${Number(r.outputMaterial||0).toFixed(2)}</td><td>${r.target||0}</td><td>${r.actual||0}</td><td>${r.rejection||0}</td><td>${r.stopMinutes||0}</td><td class="actions"><button type="button" onclick="edit('${r.id}')">Edit</button><button type="button" class="danger" onclick="del('${r.id}')">Delete</button></td></tr>`).join(''):'<tr><td colspan="12" class="muted">No matching records.</td></tr>'}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}['search','from','to','filterShift'].forEach(k=>$(k).addEventListener('input',render));
$('csvBtn').onclick=()=>{let cols=['date','shift','machine','operator','height','width','type','inputMaterial','outputMaterial','target','actual','rejection','stopMinutes','stopReason','remarks'];let csv=[cols.join(','),...filtered().map(r=>cols.map(k=>'"'+String(r[k]??'').replace(/"/g,'""')+'"').join(','))].join('\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='pouch-production-records.csv';a.click();URL.revokeObjectURL(a.href)};$('printBtn').onclick=()=>window.print();render();
if('serviceWorker'in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./service-worker.js').catch(console.error));
</script></body></html>